<Window x:Class="AutoClicker.Views.Main.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:converters="clr-namespace:AutoClicker.Infrastructure.Converters"
        mc:Ignorable="d"
        DataContext="{Binding Path=MainWindowModel, Source={StaticResource Locator}}"
        Title="Auto-Clicker"
        ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen"
        Height="450" Width="500">
    <Window.Resources>
        <converters:EnumEqualsConverter x:Key="EnumEqualsConverter" />
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="0.75*"></RowDefinition>
            <RowDefinition Height="1*"></RowDefinition>
            <RowDefinition Height="1*"></RowDefinition>
            <RowDefinition Height="1*"></RowDefinition>
            <RowDefinition Height="0.25*"></RowDefinition>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition></ColumnDefinition>
            <ColumnDefinition></ColumnDefinition>
        </Grid.ColumnDefinitions>
        <!-- Click Interval GroupBox -->
        <GroupBox Style="{StaticResource GroupBoxDefaultStyle}"
                  Grid.Row="0"
                  Grid.ColumnSpan="2"
                  Header="Click intervals">
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                <Label Style="{DynamicResource LabelDefaultStyle}">Hours:</Label>
                <TextBox Style="{DynamicResource TextBoxDefaultStyle}"
                         Text="{Binding HoursTextBox, UpdateSourceTrigger=PropertyChanged}" />
                <Label Style="{DynamicResource LabelDefaultStyle}">Minutes:</Label>
                <TextBox Style="{DynamicResource TextBoxDefaultStyle}"
                         Text="{Binding MinutesTextBox, UpdateSourceTrigger=PropertyChanged}" />
                <Label Style="{DynamicResource LabelDefaultStyle}">Seconds:</Label>
                <TextBox Style="{DynamicResource TextBoxDefaultStyle}"
                         Text="{Binding SecondsTextBox, UpdateSourceTrigger=PropertyChanged}" />
                <Label Style="{DynamicResource LabelDefaultStyle}">Milliseconds:</Label>
                <TextBox Style="{DynamicResource TextBoxDefaultStyle}"
                         Text="{Binding MillisecondsTextBox, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>
        </GroupBox>
        <!-- Click Options GroupBox -->
        <GroupBox Style="{StaticResource GroupBoxDefaultStyle}"
                  Grid.Row="1"
                  Grid.Column="0"
                  Header="Click options">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition></RowDefinition>
                    <RowDefinition></RowDefinition>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition></ColumnDefinition>
                    <ColumnDefinition></ColumnDefinition>
                </Grid.ColumnDefinitions>
                <Label Grid.Row="0"
                       Grid.Column="0"
                       Content="Mouse button:">
                </Label>
                <ComboBox Grid.Row="0"
                          Grid.Column="1"
                          Margin="2"
                          ItemsSource="{Binding MouseButtonOptions}"
                          SelectedItem="{Binding SelectedMouseButton}">
                </ComboBox>
                <Label Grid.Row="1"
                       Grid.Column="0"
                       Content="Click mode:">
                </Label>
                <ComboBox Grid.Row="1"
                          Grid.Column="1"
                          Margin="2"
                          ItemsSource="{Binding ClickBurstOptions}"
                          SelectedItem="{Binding SelectedMouseButtonMode}">
                </ComboBox>
            </Grid>
        </GroupBox>
        <!-- Click Repeat GroupBox -->
        <GroupBox Style="{StaticResource GroupBoxDefaultStyle}"
                  Grid.Row="1"
                  Grid.Column="1"
                  Header="Click repeats">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition></RowDefinition>
                    <RowDefinition></RowDefinition>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition></ColumnDefinition>
                    <ColumnDefinition></ColumnDefinition>
                </Grid.ColumnDefinitions>
                <RadioButton Grid.Row="0"
                             Grid.Column="0"
                             Content="Repeat"
                             Margin="6"
                             HorizontalAlignment="Left"
                             VerticalAlignment="Center"
                             GroupName="RepeatMode"
                             IsChecked="{Binding RepeatMode, Converter={StaticResource EnumEqualsConverter}, ConverterParameter=Times, UpdateSourceTrigger=PropertyChanged}">
                </RadioButton>
                <StackPanel Grid.Row="0"
                            Grid.Column="1"
                            Orientation="Horizontal"
                            IsEnabled="{Binding RepeatMode, Converter={StaticResource EnumEqualsConverter}, ConverterParameter=Times}">
                    <TextBox Style="{StaticResource TextBoxDefaultStyle}"
                             HorizontalContentAlignment="Center"
                             VerticalContentAlignment="Center"
                             Margin="2"
                             Width="40"
                             Text="{Binding RepeatTimesTextBox, UpdateSourceTrigger=PropertyChanged}"
                             MaxLength="5">
                    </TextBox>
                    <Label Style="{StaticResource LabelDefaultStyle}">times</Label>
                </StackPanel>
                <RadioButton Grid.Row="1"
                             Grid.Column="0"
                             Grid.ColumnSpan="2"
                             Content="Repeat until stopped"
                             Margin="6"
                             HorizontalAlignment="Left"
                             VerticalAlignment="Center"
                             GroupName="RepeatMode"
                             IsChecked="{Binding RepeatMode, Converter={StaticResource EnumEqualsConverter}, ConverterParameter=UntilStopped, UpdateSourceTrigger=PropertyChanged}">
                </RadioButton>
            </Grid>
        </GroupBox>
        <!-- Cursor Position GroupBox -->
        <GroupBox Style="{StaticResource GroupBoxDefaultStyle}"
                  Grid.Row="2"
                  Grid.Column="0"
                  Grid.ColumnSpan="2"
                  Header="Cursor position">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="0.85*"></ColumnDefinition>
                    <ColumnDefinition Width="*"></ColumnDefinition>
                </Grid.ColumnDefinitions>
                <RadioButton Content="Current location"
                             VerticalAlignment="Center"
                             HorizontalAlignment="Left"
                             GroupName="PositionMode"
                             IsChecked="{Binding PositionMode, Converter={StaticResource EnumEqualsConverter}, ConverterParameter=Current, UpdateSourceTrigger=PropertyChanged}">
                </RadioButton>
                <StackPanel Grid.Row="0"
                           Grid.Column="1"
                           Orientation="Horizontal"
                           VerticalAlignment="Center">
                    <RadioButton VerticalAlignment="Center"
                                 HorizontalAlignment="Left"
                                 VerticalContentAlignment="Center"
                                 HorizontalContentAlignment="Center"
                                 GroupName="PositionMode"
                                 IsChecked="{Binding PositionMode, Converter={StaticResource EnumEqualsConverter}, ConverterParameter=Fixed, UpdateSourceTrigger=PropertyChanged}">
                    </RadioButton>
                    <StackPanel Orientation="Horizontal"
                                Margin="5"
                                IsEnabled="{Binding PositionMode, Converter={StaticResource EnumEqualsConverter}, ConverterParameter=Fixed}">
                        <Button Style="{StaticResource ButtonDefaultStyle}"
                                Height="25"
                                Width="75"
                                Content="Pick location"
                                Command="{Binding GetCursorPosition}"
                                IsEnabled="{Binding IsPickLocationBtnEnable}">
                        </Button>
                        <Label Style="{StaticResource LabelDefaultStyle}">X:</Label>
                        <TextBox Style="{StaticResource TextBoxDefaultStyle}"
                                 Text="{Binding XAxisTextBox, UpdateSourceTrigger=PropertyChanged}" />
                        <Label Style="{StaticResource LabelDefaultStyle}">Y:</Label>
                        <TextBox Style="{StaticResource TextBoxDefaultStyle}"
                                 Text="{Binding YAxisTextBox, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                </StackPanel>
            </Grid>
        </GroupBox>
        <!-- Button Section Grid -->
        <Grid Grid.Row="3"
              Grid.Column="0"
              Grid.ColumnSpan="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition></ColumnDefinition>
                <ColumnDefinition></ColumnDefinition>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition></RowDefinition>
                <RowDefinition></RowDefinition>
            </Grid.RowDefinitions>
            <Button Style="{StaticResource ButtonDefaultStyle}"
                    Grid.Row="0"
                    Grid.Column="0"
                    Margin="10"
                    Width="150"
                    Content="Start"
                    Command="{Binding StartClicking}">
            </Button>
            <Button Style="{StaticResource ButtonDefaultStyle}"
                    Grid.Row="0"
                    Grid.Column="1"
                    Margin="10"
                    Width="150"
                    Content="Stop"
                    Command="{Binding StopClicking}">
            </Button>
            <Button Style="{StaticResource ButtonDefaultStyle}"
                    Grid.Row="1"
                    Grid.Column="0"
                    Grid.ColumnSpan="2"
                    Margin="10,5,10,15"
                    Width="150"
                    Content="Hotkeys"
                    Command="{Binding OpenHotKeysWindow}">
            </Button>
        </Grid>
        <!-- HotKeys Grid -->
        <Grid Grid.Column="0"
            Grid.Row="4"
            DataContext="{Binding Path=HotKeyWindowModel, Source={StaticResource Locator}}">
            <StackPanel
                        VerticalAlignment="Stretch"
                        HorizontalAlignment="Stretch"
                        Orientation="Horizontal">
                <!--Start HotKey Label-->
                <Label Style="{DynamicResource LabelBottomRowStyle}"
                       Content="{Binding StartHotKeyDisplay, UpdateSourceTrigger=PropertyChanged}"
                       ContentStringFormat="Start: [{0}]">
                </Label>
                <!--Stop HotKey Label-->
                <Label Style="{DynamicResource LabelBottomRowStyle}"
                       Content="{Binding StopHotKeyDisplay, UpdateSourceTrigger=PropertyChanged}"
                       ContentStringFormat="Stop: [{0}]">
                </Label>
            </StackPanel>
        </Grid>
        <Grid Grid.Column="1"
              Grid.Row="4">
            <CheckBox Content="Exit on close"
                      Margin="0,0,10,0"
                      HorizontalAlignment="Right"
                      VerticalAlignment="Center"
                      IsChecked="{Binding ExitOnClose, UpdateSourceTrigger=PropertyChanged}" />
        </Grid>
    </Grid>
</Window>
